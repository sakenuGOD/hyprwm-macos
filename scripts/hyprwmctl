#!/bin/sh
# A dependency-free client for the running Swift daemon's Unix sockets.
set -eu

usage() {
    cat <<'HELP'
Usage: hyprwmctl status
       hyprwmctl focus|move left|right|up|down
       hyprwmctl pan left|right|up|down|reset
       hyprwmctl layout balance|retile|togglesplit|fullscreen
       hyprwmctl reload|pause|resume|restore-all|float
       hyprwmctl subscribe

HYPRWM_CTL selects the command socket (default /tmp/hyprwm.ctl).
HYPRWM_EVENTS selects the event socket (default $HYPRWM_CTL.events).
HELP
}
fail() { printf '%s\n' "hyprwmctl: $*" >&2; exit 1; }
[ "$#" -gt 0 ] || { usage >&2; exit 2; }
socket=${HYPRWM_CTL:-/tmp/hyprwm.ctl}
operation=$1
shift
case "$operation" in
    -h|--help|help) usage; exit 0 ;;
    status|reload|pause|resume|restore-all|float)
        [ "$#" -eq 0 ] || fail "$operation takes no arguments"
        command=$operation ;;
    focus|move)
        [ "$#" -eq 1 ] || fail "$operation requires one direction"
        case "$1" in left|right|up|down) command="$operation $1" ;; *) fail "invalid direction: $1" ;; esac ;;
    pan)
        [ "$#" -eq 1 ] || fail "pan requires one direction or reset"
        case "$1" in left|right|up|down|reset) command="pan $1" ;; *) fail "invalid pan action: $1" ;; esac ;;
    layout)
        [ "$#" -eq 1 ] || fail "layout requires one action"
        case "$1" in balance|retile|togglesplit|fullscreen) command=$1 ;; *) fail "unsupported layout action: $1" ;; esac ;;
    subscribe)
        [ "$#" -eq 0 ] || fail "subscribe takes no arguments"
        event_socket=${HYPRWM_EVENTS:-$socket.events}
        [ -S "$event_socket" ] || fail "event socket is unavailable: $event_socket"
        exec /usr/bin/nc -U "$event_socket" ;;
    *) fail "unknown command: $operation (use --help)" ;;
esac
[ -S "$socket" ] || fail "daemon socket is unavailable: $socket"
restore_deadline=0
if [ "$operation" = restore-all ]; then restore_deadline=$(($(date +%s) + 4)); fi
while :; do
    response=$(printf '%s\n' "$command" | /usr/bin/nc -U -w 5 "$socket") || fail "daemon connection failed"
    [ -n "$response" ] || fail "daemon returned no response"
    case "$operation:$response" in
        restore-all:'error: Lite restoration pending:'*|restore-all:'error: Engine restoration pending:'*)
            [ "$(date +%s)" -lt "$restore_deadline" ] || break
            sleep 0.1 ;;
        *) break ;;
    esac
done
printf '%s\n' "$response"
# The existing wire protocol returns plain text, so accept only known successes.
case "$operation:$response" in
    status:\{*) exit 0 ;;
    focus:*'(queued)'*) exit 0 ;;
    pan:'content pan queued:'*|pan:'All window content already fits') exit 0 ;;
    move:ok|layout:ok|float:ok|reload:'configuration reloaded'|pause:paused|resume:enabled) exit 0 ;;
    restore-all:restored*|restore-all:'no hidden windows') exit 0 ;;
    *) exit 1 ;;
esac
